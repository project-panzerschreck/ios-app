// Shared signing defaults. Put personal values in Signing.local.xcconfig.
LOCAL_DEVELOPMENT_TEAM =
APP_BUNDLE_IDENTIFIER = dev.local.distributed-ml-ggml-client-ios
TESTS_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER).Tests
UITESTS_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER).UITests

DEVELOPMENT_TEAM = $(LOCAL_DEVELOPMENT_TEAM)

#include? "Signing.local.xcconfig"
